window.screen.gameScreen.customer.Customer --> window.soundPlayer.DoorBellSoundPlayer
window.screen.gameScreen.customer.Customer --> window.soundPlayer.CorrectSoundPlayer
window.screen.gameScreen.customer.Customer --> window.soundPlayer.IncorrectSoundPlayer
window.screen.gameScreen.customer.Customer --> window.soundPlayer.WalkingSoundPlayer

window.screen.gameScreen.pot.Pot --> window.screen.gameScreen.ingredient.Ingredient
window.screen.gameScreen.ingredient.Ingredient --> window.screen.gameScreen.pot.Pot
window.screen.gameScreen.ingredient.Ingredient --> window.screen.gameScreen.cutBoard.CutBoard
window.screen.gameScreen.ingredient.Ingredient --> window.screen.gameScreen.customer.Customer

