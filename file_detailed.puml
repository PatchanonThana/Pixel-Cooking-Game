window.screen.mainScreen.MainScreen --> window.soundPlayer.InGameBGMPlayer
window.screen.mainScreen.MainScreen --> window.soundPlayer.DoorBellSoundPlayer

window.screen.gameScreen.pot.Pot --> window.soundPlayer.FrySoundPlayer
window.screen.gameScreen.pot.Pot --> window.soundPlayer.FryCapSoundPlayer
window.screen.gameScreen.pot.Pot --> window.soundPlayer.StreamSoundPlayer
window.screen.gameScreen.pot.Pot --> window.soundPlayer.BoilSoundPlayer
